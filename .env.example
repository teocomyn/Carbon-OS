# Supabase — valeurs publiques disponibles dans Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# CAPTCHA facultatif — activer dans Supabase seulement après avoir ajouté ce site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret serveur uniquement — préférer la clé sb_secret_ moderne
SUPABASE_SECRET_KEY=sb_secret_your_key

# Compatibilité facultative avec l’ancienne clé service_role
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# Identité publique de l’éditeur — à compléter avant collecte de comptes réelle
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_REGISTRATION=
LEGAL_CONTACT_EMAIL=
